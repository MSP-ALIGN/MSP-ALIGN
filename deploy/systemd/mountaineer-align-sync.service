[Unit]
Description=Mountaineer Align - sync ITFlow and NinjaOne
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/php /opt/mountaineer-align/bin/align sync --trigger=schedule --quiet
TimeoutStartSec=45min
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
