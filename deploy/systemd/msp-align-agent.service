[Unit]
Description=MSP Align - run update, backup and restore requests
After=mariadb.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/php /opt/msp-align/scripts/agent.php run
# An update re-runs the installer, which can take several minutes
TimeoutStartSec=45min
# Don't let an update's apache/mariadb restarts take this job down with them
KillMode=process
Nice=5
# No ProtectSystem/NoNewPrivileges here on purpose: an update runs install.sh, which installs packages, writes /etc,
# loads firewall modules and restarts services. The web app can only ask for the fixed jobs in scripts/agent.php.
