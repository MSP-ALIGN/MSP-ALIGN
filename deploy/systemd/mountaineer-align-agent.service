[Unit]
Description=MSP-ALIGN - run update, backup and restore requests
After=mariadb.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/php /opt/mountaineer-align/scripts/agent.php run
# An update re-runs the installer, which can take several minutes
TimeoutStartSec=45min
# Don't let an update's apache/mariadb restarts take this job down with them
KillMode=process
Nice=5
