# MSP Align with Docker: copy this file to .env and fill it in. See docs/DOCKER.md.

# The address people will use (https, no path). With compose.caddy.yaml this name must point at this machine.
ALIGN_URL=https://align.example.com
# Time zone, e.g. America/Los_Angeles
ALIGN_TZ=UTC
# First admin, created on the first start (the temporary password is in: docker compose logs app)
ALIGN_ADMIN_EMAIL=admin@example.com
ALIGN_ADMIN_NAME=Administrator
# Database password: make up a long random one, e.g.  openssl rand -base64 24
ALIGN_DB_PASSWORD=

# Your own reverse proxy (BunkerWeb, nginx, Traefik...): its address, so the app believes its X-Forwarded-For and
# X-Forwarded-Proto headers. A proxy on this machine: 172.30.57.1. On another machine: that machine's address.
# Not needed with compose.caddy.yaml.
ALIGN_TRUSTED_PROXIES=
# Where the plain-HTTP port listens: 127.0.0.1 (a proxy on this machine) or this machine's LAN address (a proxy on
# another machine). 0.0.0.0 opens it on every address, which Docker does past ufw: avoid it unless you must.
ALIGN_BIND=127.0.0.1
ALIGN_PORT=8080

# Pin a version instead of the latest release, e.g. 2.0.0
ALIGN_VERSION=latest
# MariaDB memory (about a quarter of the machine's RAM)
ALIGN_DB_BUFFER_POOL=512M
# The compose network (change only if it clashes with a network you already use), and Caddy's address in it
ALIGN_SUBNET=172.30.57.0/24
ALIGN_CADDY_IP=172.30.57.10
