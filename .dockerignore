# Kept out of the MSP Align image
.git
.github
.gitignore
.dockerignore
.env
.env.*
tests
tools
docs
# deploy/ holds systemd units the image doesn't use, but the release key file stays: the agent's update check
# only trusts signed release tags when it is present (2.2.1)
deploy/*
!deploy/release-signers
compose*.yaml
Dockerfile
**/__pycache__
*.log
# a local development config or build output must never end up in an image layer
/config.php
_site
.idea
.vscode
